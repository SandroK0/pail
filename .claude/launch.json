{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pail",
      "runtimeExecutable": "go",
      "runtimeArgs": [
        "run",
        "."
      ],
      "port": 8080
    },
    {
      "name": "pail-verify",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "AUTH=verify exec go run ."
      ],
      "port": 8080
    },
    {
      "name": "playground",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "playground/artisan",
        "serve",
        "--port=8000"
      ],
      "port": 8000
    }
  ]
}
