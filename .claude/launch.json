{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pail",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "go build -o bin/pail . && exec bin/pail"],
      "port": 8080
    },
    {
      "name": "pail-verify",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "go build -o bin/pail . && AUTH=verify exec bin/pail"],
      "port": 8080
    },
    {
      "name": "playground",
      "runtimeExecutable": "php",
      "runtimeArgs": ["playground/artisan", "serve", "--port=8000"],
      "port": 8000
    }
  ]
}
